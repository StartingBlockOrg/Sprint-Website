---
import Brand from './Brand.astro';
import StoreButton from './StoreButton.astro';
import { url } from '../lib/site';

// The header carries the blog and the App Store button only; pages are listed in the footer (WEB-6).
const blog = url('/blog/');
const current = Astro.url.pathname.startsWith(blog) ? 'page' : undefined;
---
<header class="site-head">
  <Brand />
  <nav class="site-nav" aria-label="Site">
    <a href={blog} aria-current={current}>Blog</a>
    <StoreButton compact />
  </nav>
</header>
