---
import { site, url } from '../lib/site';

interface Props {
  compact?: boolean;
}

// Apple's badge artwork, unmodified (developer.apple.com/app-store/marketing/guidelines). Rules kept
// here: at least 40px tall on screen, clear space of a quarter of its height (a tenth in the header,
// Apple's "very limited layout"), never recoloured, resized out of proportion or animated.
// Apple licenses the badge only for apps available for download, so until the listing exists
// (site.appStoreUrl) this is plain text with no badge shape (WEB-6).
const BADGE = { src: url('/badges/download-on-the-app-store.svg'), width: 119.66407, height: 40 };

const { compact = false } = Astro.props;
const height = compact ? 40 : 54;
const width = Math.round((BADGE.width / BADGE.height) * height);
const href = site.appStoreUrl;
---
{href ? (
  <a class:list={['store', compact && 'compact']} href={href} style={`--badge-h:${height}px`}>
    <img src={BADGE.src} width={width} height={height} alt="Download on the App Store" />
  </a>
) : (
  <span class:list={['soon', compact && 'compact']}>Coming soon<span class="soon-more"> to the App Store</span></span>
)}
